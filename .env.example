# Server
PORT=3000

# Optional: where the SQLite file lives (defaults to ./data/virative.db)
# DB_PATH=/var/data/virative.db

# Optional email notifications for new inquiries.
# Leave blank to disable — submissions are always saved to the database.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO=you@virative.com
CONTACT_FROM="Virative Site <you@virative.com>"
